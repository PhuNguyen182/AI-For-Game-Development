{
  "autoMemoryEnabled": false,
  "env": {
    "XERJ_DISABLE_FEEDBACK": "true"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git reflog:*)",
      "Bash(git shortlog:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git name-rev:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git grep:*)",
      "Bash(git fsck:*)",
      "Bash(git count-objects:*)",
      "Bash(git branch --list:*)",
      "Bash(git tag --list:*)",
      "Bash(git tag -l:*)",
      "Bash(git stash list:*)",
      "Bash(git bisect log:*)",
      "Bash(git worktree list:*)",
      "Bash(git submodule status:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git lfs ls-files:*)",
      "Bash(git lfs env:*)",
      "Bash(git lfs fsck:*)",
      "Bash(git clean -xdn:*)",
      "Bash(git clean -nd:*)",
      "Bash(git clean --dry-run:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "PowerShell(git checkout *)",
      "Bash(unity build*)",
      "Bash(unity command build run*)",
      "Bash(unity command build.target switch*)",
      "Bash(fastlane *)",
      "Bash(bundle exec fastlane *)",
      "Bash(firebase appdistribution*)",
      "Bash(xcrun altool*)",
      "Bash(xcrun notarytool*)",
      "Bash(git filter-repo*)",
      "Bash(git filter-branch*)",
      "Bash(git lfs migrate*)",
      "PowerShell(unity build*)",
      "PowerShell(unity command build run*)",
      "PowerShell(unity command build.target switch*)",
      "PowerShell(fastlane *)",
      "PowerShell(bundle exec fastlane *)",
      "PowerShell(firebase appdistribution*)",
      "PowerShell(xcrun altool*)",
      "PowerShell(xcrun notarytool*)",
      "PowerShell(git filter-repo*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git lfs migrate*)",
      "mcp__unity-editor-mcp__build",
      "mcp__unity-editor-mcp__switch_build_target",
      "mcp__unity_extended-mcp__unity_build"
    ],
    "deny": [
      "Bash(xerj feedback*)",
      "PowerShell(xerj feedback*)",
      "Bash(xerj -* feedback*)",
      "PowerShell(xerj -* feedback*)",
      "Bash(xerj share*)",
      "PowerShell(xerj share*)",
      "Bash(xerj -* share*)",
      "PowerShell(xerj -* share*)",
      "Bash(xerj init*)",
      "PowerShell(xerj init*)",
      "mcp__xerj__xerj_field_report",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(git clean --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git clean --force*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/Temp/UnityConnectCache.json)",
      "Read(**/Library/Pipeline/.unity-pipeline-port)",
      "Edit(/Library/**)",
      "Edit(/Temp/**)",
      "Edit(/Logs/**)",
      "Edit(/UserSettings/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Scanning for secrets",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git -C * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(git -C * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git *push*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-push.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Scanning unpushed commits for secrets",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(git *push*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-push.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Scanning unpushed commits for secrets",
            "onFailure": "block"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode check; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "Bash(unity *)",
            "onFailure": "block"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode check; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "PowerShell(unity *)",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(rg *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git grep*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode acquire; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Checking the Unity Editor lock",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.claude/**)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-edit.ps1\"; exit $LASTEXITCODE",
            "timeout": 60,
            "statusMessage": "Verifying the .claude layer"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/package-changed.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "Edit(/Packages/manifest.json)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/package-changed.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "Bash(unity command package *)"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/package-changed.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "PowerShell(unity command package *)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode release; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode clear; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/memory-capture.ps1\"; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode clear; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/memory-capture.ps1\"; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
