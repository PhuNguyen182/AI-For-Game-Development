{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git reflog:*)",
      "Bash(git shortlog:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git name-rev:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git grep:*)",
      "Bash(git fsck:*)",
      "Bash(git count-objects:*)",
      "Bash(git branch --list:*)",
      "Bash(git tag --list:*)",
      "Bash(git tag -l:*)",
      "Bash(git stash list:*)",
      "Bash(git bisect log:*)",
      "Bash(git worktree list:*)",
      "Bash(git submodule status:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git lfs ls-files:*)",
      "Bash(git lfs env:*)",
      "Bash(git lfs fsck:*)",
      "Bash(git clean -xdn:*)",
      "Bash(git clean -nd:*)",
      "Bash(git clean --dry-run:*)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git push *)",
      "PowerShell(git checkout *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(git clean --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git clean --force*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Scanning for secrets"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing"
          },
          {
            "type": "command",
            "if": "Bash(git -C * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing"
          },
          {
            "type": "command",
            "if": "PowerShell(git -C * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 30,
            "statusMessage": "Checking staged secrets and .meta pairing"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.claude/**)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-edit.ps1\"; exit $LASTEXITCODE",
            "timeout": 60,
            "statusMessage": "Verifying the .claude layer"
          }
        ]
      }
    ]
  }
}
