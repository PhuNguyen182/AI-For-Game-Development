{
  "autoMemoryEnabled": false,
  "env": {
    "XERJ_DISABLE_FEEDBACK": "true"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git reflog)",
      "Bash(git reflog -*)",
      "Bash(git reflog show:*)",
      "Bash(git reflog list:*)",
      "Bash(git reflog exists:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git stash create:*)",
      "Bash(git --version)",
      "Bash(git shortlog:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git name-rev:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git fsck:*)",
      "Bash(git count-objects:*)",
      "Bash(git branch --list:*)",
      "Bash(git tag --list:*)",
      "Bash(git tag -l:*)",
      "Bash(git stash list:*)",
      "Bash(git bisect log:*)",
      "Bash(git worktree list:*)",
      "Bash(git submodule status:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git lfs ls-files:*)",
      "Bash(git lfs env:*)",
      "Bash(git lfs fsck --dry-run:*)",
      "Bash(git lfs fsck -d:*)",
      "Bash(git clean -xdn:*)",
      "Bash(git clean -nd:*)",
      "Bash(git clean --dry-run:*)",
      "Bash(git tag backup/*)",
      "Bash(git stash show:*)",
      "Bash(git check-attr:*)",
      "PowerShell(git stash show:*)",
      "PowerShell(git check-attr:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git blame:*)",
      "PowerShell(git reflog)",
      "PowerShell(git reflog -*)",
      "PowerShell(git reflog show:*)",
      "PowerShell(git reflog list:*)",
      "PowerShell(git reflog exists:*)",
      "PowerShell(git for-each-ref:*)",
      "PowerShell(git stash create:*)",
      "PowerShell(git --version)",
      "PowerShell(git shortlog:*)",
      "PowerShell(git rev-list:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git merge-base:*)",
      "PowerShell(git name-rev:*)",
      "PowerShell(git describe:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git ls-tree:*)",
      "PowerShell(git cat-file:*)",
      "PowerShell(git fsck:*)",
      "PowerShell(git count-objects:*)",
      "PowerShell(git branch --list:*)",
      "PowerShell(git tag --list:*)",
      "PowerShell(git tag -l:*)",
      "PowerShell(git stash list:*)",
      "PowerShell(git bisect log:*)",
      "PowerShell(git worktree list:*)",
      "PowerShell(git submodule status:*)",
      "PowerShell(git remote -v)",
      "PowerShell(git remote get-url:*)",
      "PowerShell(git config --get:*)",
      "PowerShell(git config --list:*)",
      "PowerShell(git lfs ls-files:*)",
      "PowerShell(git lfs env:*)",
      "PowerShell(git lfs fsck --dry-run:*)",
      "PowerShell(git lfs fsck -d:*)",
      "PowerShell(git clean -xdn:*)",
      "PowerShell(git clean -nd:*)",
      "PowerShell(git clean --dry-run:*)",
      "PowerShell(git tag backup/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "PowerShell(git checkout *)",
      "Bash(unity build*)",
      "Bash(unity command build run*)",
      "Bash(unity command build.target switch*)",
      "Bash(fastlane *)",
      "Bash(bundle exec fastlane *)",
      "Bash(firebase appdistribution*)",
      "Bash(xcrun altool*)",
      "Bash(xcrun notarytool*)",
      "Bash(git filter-repo*)",
      "Bash(git filter-branch*)",
      "Bash(git lfs migrate*)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git reflog drop*)",
      "Bash(git lfs prune*)",
      "Bash(git worktree remove*)",
      "Bash(git update-ref -d*)",
      "PowerShell(git gc*)",
      "PowerShell(git prune*)",
      "PowerShell(git reflog expire*)",
      "PowerShell(git reflog delete*)",
      "PowerShell(git reflog drop*)",
      "PowerShell(git lfs prune*)",
      "PowerShell(git worktree remove*)",
      "PowerShell(git update-ref -d*)",
      "PowerShell(unity build*)",
      "PowerShell(unity command build run*)",
      "PowerShell(unity command build.target switch*)",
      "PowerShell(fastlane *)",
      "PowerShell(bundle exec fastlane *)",
      "PowerShell(firebase appdistribution*)",
      "PowerShell(xcrun altool*)",
      "PowerShell(xcrun notarytool*)",
      "PowerShell(git filter-repo*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git lfs migrate*)",
      "mcp__unity-editor-mcp__build",
      "mcp__unity-editor-mcp__switch_build_target",
      "mcp__unity_extended-mcp__unity_build"
    ],
    "deny": [
      "Bash(xerj feedback*)",
      "PowerShell(xerj feedback*)",
      "Bash(xerj -* feedback*)",
      "PowerShell(xerj -* feedback*)",
      "Bash(xerj share*)",
      "PowerShell(xerj share*)",
      "Bash(xerj -* share*)",
      "PowerShell(xerj -* share*)",
      "Bash(xerj init*)",
      "PowerShell(xerj init*)",
      "mcp__xerj__xerj_field_report",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(git clean --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git clean --force*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/Temp/UnityConnectCache.json)",
      "Read(**/Library/Pipeline/.unity-pipeline-port)",
      "Edit(/Library/**)",
      "Edit(/Temp/**)",
      "Edit(/Logs/**)",
      "Edit(/UserSettings/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Scanning for secrets",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git -C * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*git *commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(git -C * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(git * commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*| git commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*git *--continue*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*git *--continue*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Checking staged secrets and .meta pairing",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*git *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*git *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*git.exe*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*git.exe*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*git *push*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-push.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Scanning unpushed commits for secrets",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(*git *push*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/pre-push.ps1\"; exit $LASTEXITCODE",
            "timeout": 120,
            "statusMessage": "Scanning unpushed commits for secrets",
            "onFailure": "block"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode check; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "Bash(unity *)",
            "onFailure": "block"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode check; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "PowerShell(unity *)",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(grep *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(rg *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git grep*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/search-guard.ps1\"; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode acquire; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Checking the Unity Editor lock",
            "onFailure": "block"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/round-cap.ps1\" -Mode dispatch; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Checking round caps",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__unity.*",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode check; exit $LASTEXITCODE",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.claude/**)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-edit.ps1\"; exit $LASTEXITCODE",
            "timeout": 60,
            "statusMessage": "Verifying the .claude layer"
          },
          {
            "type": "command",
            "if": "Edit(.workflow/**)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/round-cap.ps1\" -Mode edit; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/package-changed.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "Edit(/Packages/manifest.json)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/package-changed.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "Bash(unity command package *)"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/package-changed.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "if": "PowerShell(unity command package *)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode release; exit $LASTEXITCODE",
            "timeout": 30
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/round-cap.ps1\" -Mode count; exit $LASTEXITCODE",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode clear; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/memory-capture.ps1\"; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/editor-lock.ps1\" -Mode clear; exit $LASTEXITCODE",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/memory-capture.ps1\"; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
