# Zero-Mem traces: one append-only file per session, generated by the Stop hook. Keep them diffable:
# the pre-commit secret scan reads staged diffs.
.memory/traces/** text eol=lf linguist-generated

# Bash fails on a CRLF checkout.
.claude/skills/**/scripts/*.sh text eol=lf

# Bug journal: the truth behind .workflow/bugs.db (skill bugs). Branches append; a union merge keeps both sides.
.workflow/bugs.jsonl text eol=lf merge=union
